# instorematchd systemd 单元（由 install.sh 生成，__HOST_OVERRIDE__ 会替换成你的域名/IP）
[Unit]
Description=instorematchd (maimai in-store matching lobby + relay)
After=network.target

[Service]
Type=simple
User=instorematchd
Group=instorematchd
WorkingDirectory=/opt/instorematchd

# 管理员视图的 token 放在这里（install.sh 会写，权限 600）：
#   IMD_ADMIN_TOKEN=xxxxx
# 没有这个文件也能跑：公开看板照常，只是不开放 /admin
EnvironmentFile=-/etc/instorematchd.env

# --host-override 必须填客户端能访问到的地址（域名或公网 IP）：
# /info 会把它作为中继地址下发给客户端，不填的话走反向代理时
# 客户端会拿到 127.0.0.1 而连不上中继。
ExecStart=/usr/bin/python3 /opt/instorematchd/instorematchd.py \
    --host-override __HOST_OVERRIDE__ \
    --lobby-port __LOBBY_PORT__ \
    --relay-port __RELAY_PORT__ \
    --recruit-ttl 30 \
    --heartbeat-timeout 30

Restart=on-failure
RestartSec=5
# 正常情况收到 SIGTERM 会立刻退出；万一以后又写出吞信号的 bug，
# 这里最多等 10 秒就 SIGKILL，不用干等默认的 90 秒
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=instorematchd

[Install]
WantedBy=multi-user.target
